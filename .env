# Example environment variables for Wild Strikes Aptos Monorepo

# Server
PORT=3001
HOST=192.168.100.6
NEXT_PUBLIC_SOCKET_HOST=192.168.100.6
NEXT_PUBLIC_SOCKET_PORT=3001

# Client - Socket.IO connection
NEXT_PUBLIC_SOCKET_URL=http://192.168.100.6:3001
SOCKET_HOST=192.168.100.6
SOCKET_PORT=3001
# Add any other client-side environment variables here
# NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development
